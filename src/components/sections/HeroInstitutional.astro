---
import type { Company } from "../../types/site";
import { whatsappHref } from "../../lib/whatsapp";
import Container from "../ui/Container.astro";
import Button from "../ui/Button.astro";

interface Props {
  company: Company;
}

const { company } = Astro.props;
const waLink = whatsappHref(company.whatsapp);
const telDigits = company.phone.replace(/\D/g, "");
const telLink = telDigits ? `tel:+55${telDigits.replace(/^55/, "")}` : "#";
---

<section id="topo" class="hero" aria-labelledby="hero-title">
  <div class="hero-bg" aria-hidden="true"></div>
  <Container>
    <div class="hero-inner">
      <p class="eyebrow">{company.category}</p>
      <h1 id="hero-title">{company.name}</h1>
      <p class="lead">{company.description}</p>
      <div class="actions">
        <Button href={waLink} external>Falar no WhatsApp</Button>
        {telDigits ? (
          <Button href={telLink} variant="ghost">
            Ligar agora
          </Button>
        ) : null}
      </div>
    </div>
  </Container>
</section>

<style>
  .hero {
    position: relative;
    padding: clamp(3rem, 8vw, 5rem) 0 calc(var(--space-section-y) + 0.5rem);
    overflow: hidden;
    border-bottom: 1px solid var(--color-border-subtle, oklch(0.9 0.01 260));
  }

  .hero-bg {
    position: absolute;
    inset: 0;
    background: var(--gradient-mesh, none), var(--color-surface-elevated, var(--color-bg));
    opacity: 1;
    pointer-events: none;
  }

  .hero-inner {
    position: relative;
    max-width: 38rem;
  }

  .eyebrow {
    margin: 0 0 0.65rem;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-primary-muted, var(--color-primary));
    font-family: var(--font-sans);
  }

  h1 {
    margin: 0 0 1rem;
    font-size: clamp(2.15rem, 5vw, 3rem);
    line-height: 1.08;
    color: var(--color-text);
  }

  .lead {
    margin: 0 0 1.75rem;
    font-size: 1.125rem;
    line-height: 1.65;
    color: var(--color-text-muted);
    font-family: var(--font-sans);
    font-weight: 450;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem;
  }
</style>
