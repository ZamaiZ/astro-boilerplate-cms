---
import type { Company } from "../../types/site";
import { whatsappHref } from "../../lib/whatsapp";
import Container from "../ui/Container.astro";
import Button from "../ui/Button.astro";

interface Props {
  company: Company;
  domain: string;
}

const { company, domain } = Astro.props;
const waLink = whatsappHref(company.whatsapp);
---

<section id="contato" class="cta" aria-labelledby="contato-heading">
  <Container>
    <div class="cta-panel">
      <div class="cta-copy">
        <h2 id="contato-heading">Vamos conversar?</h2>
        <p>
          Solicite um atendimento pelo WhatsApp. Respondemos rápido para entender sua necessidade em{" "}
          <strong>{company.city}</strong>.
        </p>
        <p class="domain-line">
          <span class="muted">Site</span> · {domain}
        </p>
      </div>
      <div class="cta-action">
        <Button href={waLink} external>Abrir WhatsApp</Button>
      </div>
    </div>
  </Container>
</section>

<style>
  .cta {
    padding: calc(var(--space-section-y) * 0.55) 0;
  }

  .cta-panel {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1.75rem;
    padding: clamp(1.75rem, 4vw, 2.5rem);
    border-radius: calc(var(--radius-md) + 4px);
    background: linear-gradient(
      135deg,
      var(--color-primary-soft, oklch(0.97 0.02 260)),
      var(--color-white)
    );
    border: 1px solid var(--color-border-subtle, oklch(0.9 0.01 260));
    box-shadow: var(--shadow-md);
  }

  .cta-copy {
    flex: 1 1 280px;
    max-width: 36rem;
  }

  h2 {
    margin: 0 0 0.65rem;
    font-size: clamp(1.45rem, 3vw, 1.85rem);
    font-family: var(--font-display);
    letter-spacing: -0.02em;
    color: var(--color-text);
  }

  .cta-copy p {
    margin: 0 0 0.75rem;
    color: var(--color-text-muted);
    font-size: 1.05rem;
    line-height: 1.6;
    font-family: var(--font-sans);
  }

  .domain-line {
    margin: 0 !important;
    font-size: 0.95rem !important;
    color: var(--color-text-muted);
  }

  .muted {
    font-weight: 600;
    color: var(--color-text);
  }

  .cta-action {
    flex-shrink: 0;
  }
</style>
