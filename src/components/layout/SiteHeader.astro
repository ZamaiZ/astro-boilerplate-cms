---
import type { Company } from "../../types/site";
import logoUrl from "../../assets/logo.webp?url";
import Container from "../ui/Container.astro";

interface Props {
  company: Company;
}

const { company } = Astro.props;
const wordmark = company.name.trim() || "Marca";
---

<header class="site-header">
  <Container>
    <div class="header-inner">
      <details class="nav-mobile">
        <summary>
          <span class="visually-hidden">Abrir menu</span>
          <span aria-hidden="true" class="burger">
            <span></span><span></span><span></span>
          </span>
        </summary>
        <ul>
          <li><a href="#servicos">Serviços</a></li>
          <li><a href="#sobre">Sobre</a></li>
          <li><a href="#contato">Contato</a></li>
        </ul>
      </details>

      <a class="brand" href="#topo" aria-label={`${wordmark} — início`}>
        <img src={logoUrl} alt="" class="brand-logo" width="160" height="48" loading="eager" fetchpriority="high" decoding="async" />
      </a>

      <nav class="nav-desktop" aria-label="Seções">
        <ul>
          <li><a href="#servicos">Serviços</a></li>
          <li><a href="#sobre">Sobre</a></li>
          <li><a href="#contato">Contato</a></li>
        </ul>
      </nav>
    </div>
  </Container>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    border-bottom: 1px solid var(--color-border-subtle, oklch(0.9 0.01 260));
    background: color-mix(in oklch, var(--color-bg) 88%, transparent);
    backdrop-filter: blur(12px);
  }

  .header-inner {
    display: flex;
    flex-wrap: nowrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 4rem;
    width: 100%;
  }

  .brand {
    display: flex;
    flex-shrink: 0;
    align-items: center;
    text-decoration: none;
    color: inherit;
    border-radius: var(--radius-sm);
    outline-offset: 3px;
  }

  .brand:hover {
    opacity: 0.92;
  }

  .brand:focus-visible {
    outline: 2px solid var(--color-primary);
  }

  .brand-logo {
    display: block;
    height: 2.25rem;
    width: auto;
    max-width: 9rem;
    object-fit: contain;
  }

  .nav-desktop ul {
    display: flex;
    gap: 1.75rem;
    list-style: none;
    margin: 0;
    padding: 0;
    align-items: center;
  }

  .nav-desktop a {
    font-weight: 600;
    font-size: 0.95rem;
    color: var(--color-text-muted);
    text-decoration: none;
  }

  .nav-desktop a:hover {
    color: var(--color-text);
  }

  .nav-mobile {
    display: none;
    position: relative;
    flex-shrink: 0;
  }

  .nav-mobile summary {
    list-style: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    min-width: 2.75rem;
    min-height: 2.75rem;
    padding: 0.35rem;
    margin: -0.35rem 0 -0.35rem -0.35rem;
    border-radius: var(--radius-sm);
    color: var(--color-text);
    outline-offset: 2px;
  }

  .nav-mobile summary:focus-visible {
    outline: 2px solid var(--color-primary);
  }

  .nav-mobile summary::-webkit-details-marker {
    display: none;
  }

  .burger {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 1.375rem;
  }

  .burger span {
    display: block;
    height: 2px;
    border-radius: 1px;
    background: currentColor;
    transform-origin: center;
  }

  .nav-mobile ul {
    position: absolute;
    left: 0;
    top: calc(100% + 0.5rem);
    min-width: 12rem;
    margin: 0;
    padding: 0.75rem;
    list-style: none;
    background: var(--color-white);
    border: 1px solid var(--color-border-subtle, oklch(0.9 0.01 260));
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-md);
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .nav-mobile a {
    display: block;
    padding: 0.6rem 0.75rem;
    border-radius: var(--radius-sm);
    font-weight: 600;
    color: var(--color-text);
    text-decoration: none;
  }

  .nav-mobile a:hover {
    background: var(--color-bg-subtle);
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  @media (max-width: 768px) {
    .header-inner {
      justify-content: flex-start;
      gap: 0.625rem;
    }

    .nav-desktop {
      display: none;
    }

    .nav-mobile {
      display: block;
    }

    .brand-logo {
      height: 2rem;
      max-width: 8rem;
    }
  }
</style>
