---
interface Props {
  id?: string;
  eyebrow?: string;
  title: string;
  subtitle?: string;
  align?: "start" | "center";
}

const { id, eyebrow, title, subtitle, align = "start" } = Astro.props;
---

<div class:list={["heading", align === "center" && "heading--center"]}>
  {eyebrow ? <p class="eyebrow">{eyebrow}</p> : null}
  <h2 id={id}>{title}</h2>
  {subtitle ? <p class="subtitle">{subtitle}</p> : null}
</div>

<style>
  .heading {
    max-width: 42rem;
    margin-bottom: clamp(1.75rem, 4vw, 2.25rem);
  }

  .heading--center {
    margin-inline: auto;
    text-align: center;
  }

  .heading--center .subtitle {
    margin-inline: auto;
  }

  .eyebrow {
    margin: 0 0 0.5rem;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-primary-muted, var(--color-primary));
    font-family: var(--font-sans);
  }

  h2 {
    margin: 0 0 0.65rem;
    font-size: clamp(1.65rem, 3vw, 2.1rem);
    line-height: 1.2;
    color: var(--color-text);
  }

  .subtitle {
    margin: 0;
    font-size: 1.05rem;
    color: var(--color-text-muted);
    line-height: 1.55;
    font-family: var(--font-sans);
    font-weight: 450;
  }
</style>
